# Rabt local / demo configuration (no secrets committed)
FHIR_BASE_URL=http://localhost:8080/fhir
FHIR_MODE=memory
# FHIR_MODE=hapi  # when docker compose hapi is running

DATABASE_URL=sqlite+aiosqlite:///./data/rabt.db
CHANNEL=console
# console | mailpit | acs

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_MODEL=
CONTENT_SAFETY_ENDPOINT=
CS_MAX_SEVERITY=2

OTEL_SERVICE_NAME=rabt-orchestrator
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

GUEST_MODE=true
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Demo seed
DEMO_SEED=42
