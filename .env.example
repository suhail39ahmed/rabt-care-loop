# Rabt local / demo configuration (no secrets committed)
FHIR_BASE_URL=http://localhost:8080/fhir
FHIR_MODE=memory
# FHIR_MODE=hapi  # when docker compose hapi is running

DATABASE_URL=sqlite+aiosqlite:///./data/rabt.db
CHANNEL=console
# console | mailpit | acs

# Global AI kill switch (default off — demo stays template-only) (#105)
AI_ENABLED=false
# off | openai_compatible | azure (#68)
LLM_PROVIDER=off
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Legacy Azure names still accepted when LLM_* unset
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_MODEL=
AZURE_OPENAI_API_KEY=
CONTENT_SAFETY_ENDPOINT=
# Azure AI Language PII, layered after the regex scrubber; fails closed when on (APIM gateway URL or Language endpoint)
LANGUAGE_PII_ENABLED=false
LANGUAGE_ENDPOINT=
LANGUAGE_PII_MIN_CONFIDENCE=0.6
CS_MAX_SEVERITY=2

OTEL_SERVICE_NAME=rabt-orchestrator
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

GUEST_MODE=true
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Demo seed
DEMO_SEED=42
