flowchart TB
  EVT["Case event / API call"] --> SUP["Coordinator = supervisor<br/>coordinator.py"]

  SUP -->|"DelegationRequest<br/>step · depth≤2 · allowed_tools"| ROUTE{Which step?}

  ROUTE -->|data_quality| DQ["DQ agent"]
  ROUTE -->|triage| TR["Triage agent<br/>YAML rules"]
  ROUTE -->|ownership| OW["Ownership agent"]
  ROUTE -->|comms| CM["Comms agent<br/>templates ± Foundry"]
  ROUTE -->|navigate| NV["Navigator agent"]
  ROUTE -->|escalation| ES["Escalation agent"]
  ROUTE -->|closure| CL["Closure verifier"]
  ROUTE -->|reassurance| RE["Reassurance agent"]
  ROUTE -->|econsult| EC["E-consult agent"]

  DQ & TR & OW & CM & NV & ES & CL & RE & EC -->|"DelegationResult<br/>status · proposed_transition · outputs"| SUP

  SUP --> VER["Verify<br/>allowed transition? · contract OK? · guardrails?"]
  VER -->|yes| SM["state_machine.transition<br/>+ Provenance + timeline"]
  VER -->|no / needs_human| HITL["Raise to human<br/>HITL queue"]

  SM --> LED["Ledger / FHIR Task"]
