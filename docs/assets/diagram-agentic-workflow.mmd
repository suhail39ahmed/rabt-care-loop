flowchart LR
  subgraph INTAKE["1. Intake"]
    N[New] --> T[Triaged]
  end
  subgraph OWN["2. Ownership"]
    T --> AO[AwaitingOwner]
    AO -->|accept| O[Owned]
  end
  subgraph PAT["3. Patient"]
    O --> PN[PatientNotified]
    PN -->|teach-back OK| U[Understood]
  end
  subgraph CARE["4. Care"]
    U --> R[Referred]
    R --> B[Booked]
    B --> A[Attended]
  end
  subgraph CLOSE["5. Close"]
    A --> CP[ClosurePending]
    CP -->|evidence| C[Closed]
  end

  T -.->|CRITICAL| E[Escalated]
  E -.->|HITL| O
  PN -.->|fail| HC[HumanCallback]
  HC -.-> U
  CP -.->|blocked| O
