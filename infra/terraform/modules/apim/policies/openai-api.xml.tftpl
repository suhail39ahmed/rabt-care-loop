<policies>
  <inbound>
    <base />
    <include-fragment fragment-id="rabt-traffic-monitor-inbound" />
    ${auth}
    <set-header name="api-key" exists-action="delete" />
    <authentication-managed-identity resource="https://cognitiveservices.azure.com" />
    <set-backend-service backend-id="${pool_backend_id}" />
    <!-- Request-rate cap (true TPM needs openai-typed API + llm-token-limit; tokens_per_minute reserved for that). -->
    <rate-limit-by-key calls="120" renewal-period="60" counter-key="@(context.Subscription?.Id ?? context.Request.IpAddress)" />
%{ if semantic_cache ~}
    <choose>
      <when condition="@(context.Request.Headers.GetValueOrDefault(&quot;x-rabt-cacheable&quot;, &quot;false&quot;) == &quot;true&quot;)">
        <llm-semantic-cache-lookup score-threshold="${cache_score_threshold}" embeddings-backend-id="${embeddings_backend_id}" embeddings-backend-auth="system-assigned">
          <vary-by>@(context.Request.Headers.GetValueOrDefault(&quot;x-rabt-cache-scope&quot;, &quot;none&quot;))</vary-by>
        </llm-semantic-cache-lookup>
      </when>
    </choose>
%{ endif ~}
  </inbound>
  <!-- APIM allows only one top-level policy under <backend>; nest marker inside retry. -->
  <backend>
    <retry condition="@(context.Response.StatusCode == 429 || context.Response.StatusCode >= 500)" count="2" interval="1" delta="1" max-interval="8" first-fast-retry="true">
      <set-variable name="rabt-backend-called" value="true" />
      <forward-request buffer-request-body="true" timeout="60" />
    </retry>
  </backend>
  <outbound>
    <base />
    <include-fragment fragment-id="rabt-traffic-monitor-outbound" />
    <set-variable name="rabt-cache" value="@(context.Request.Headers.GetValueOrDefault(&quot;x-rabt-cacheable&quot;, &quot;false&quot;) != &quot;true&quot; ? &quot;none&quot; : (context.Variables.ContainsKey(&quot;rabt-backend-called&quot;) ? &quot;miss&quot; : &quot;hit&quot;))" />
    <set-header name="x-rabt-cache" exists-action="override">
      <value>@((string)context.Variables[&quot;rabt-cache&quot;])</value>
    </set-header>
    <emit-metric name="SemanticCacheRequests" namespace="rabt-ai-gateway" value="1">
      <dimension name="Result" value="@((string)context.Variables[&quot;rabt-cache&quot;])" />
      <dimension name="Task" value="@(context.Request.Headers.GetValueOrDefault(&quot;x-rabt-task&quot;, &quot;unknown&quot;))" />
    </emit-metric>
%{ if semantic_cache ~}
    <choose>
      <when condition="@(context.Request.Headers.GetValueOrDefault(&quot;x-rabt-cacheable&quot;, &quot;false&quot;) == &quot;true&quot;)">
        <llm-semantic-cache-store duration="${cache_ttl_seconds}" />
      </when>
    </choose>
%{ endif ~}
    <set-header name="x-ms-region" exists-action="delete" />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
