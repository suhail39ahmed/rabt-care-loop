<policies>
  <inbound>
    <base />
    ${auth}
    <set-header name="api-key" exists-action="delete" />
    <authentication-managed-identity resource="https://cognitiveservices.azure.com" />
    <set-backend-service backend-id="${pool_backend_id}" />
    <azure-openai-token-limit counter-key="@(context.Subscription?.Id ?? context.Request.IpAddress)" tokens-per-minute="${tokens_per_minute}" estimate-prompt-tokens="false" remaining-tokens-header-name="x-rabt-remaining-tokens" />
    <azure-openai-emit-token-metric namespace="rabt-ai-gateway">
      <dimension name="API ID" />
      <dimension name="Operation ID" />
      <dimension name="Task" value="@(context.Request.Headers.GetValueOrDefault(&quot;x-rabt-task&quot;, &quot;unknown&quot;))" />
      <dimension name="Deployment" value="@(context.Request.MatchedParameters.GetValueOrDefault(&quot;deployment-id&quot;, &quot;unknown&quot;))" />
    </azure-openai-emit-token-metric>
%{ if semantic_cache ~}
    <choose>
      <when condition="@(context.Request.Headers.GetValueOrDefault(&quot;x-rabt-cacheable&quot;, &quot;false&quot;) == &quot;true&quot;)">
        <azure-openai-semantic-cache-lookup score-threshold="${cache_score_threshold}" embeddings-backend-id="${embeddings_backend_id}" embeddings-backend-auth="system-assigned">
          <vary-by>@(context.Request.Headers.GetValueOrDefault(&quot;x-rabt-cache-scope&quot;, &quot;none&quot;))</vary-by>
        </azure-openai-semantic-cache-lookup>
      </when>
    </choose>
%{ endif ~}
  </inbound>
  <backend>
    <retry condition="@(context.Response.StatusCode == 429 || context.Response.StatusCode >= 500)" count="2" interval="1" delta="1" max-interval="8" first-fast-retry="true">
      <forward-request buffer-request-body="true" timeout="60" />
    </retry>
  </backend>
  <outbound>
    <base />
%{ if semantic_cache ~}
    <choose>
      <when condition="@(context.Request.Headers.GetValueOrDefault(&quot;x-rabt-cacheable&quot;, &quot;false&quot;) == &quot;true&quot;)">
        <azure-openai-semantic-cache-store duration="${cache_ttl_seconds}" />
      </when>
    </choose>
%{ endif ~}
    <set-header name="x-ms-region" exists-action="delete" />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
