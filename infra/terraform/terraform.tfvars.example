# Copy to terraform.tfvars (git-ignored, loaded automatically) for local runs.
# In GitHub Actions the same values come from repository variables (see docs/deployment.md).
# Never put keys or secrets in this file.

subscription_id = "00000000-0000-0000-0000-000000000000"

apim_publisher_email  = "you@example.com"
budget_contact_emails = ["you@example.com"]

# Your public IP (e.g. "203.0.113.10") so you can run the KB ingestion script against the
# private Search / Storage / Key Vault from your machine. Leave empty for fully private.
deployer_ip_allowlist = []
